<!--
  Single quadruped leg built from the STL parts in ../stl_parts.
  GENERATED by build_leg_model.py - edit that file, not this one.
  Units: metres, radians. Coordinates inside "leg_frame" use the FK
  convention of numpyfk3d.py (+X coxa, +Y up, +Z right-handed).
  Joint geometry from STL (STL lengths, user-approved):
    coxa 27.49 mm, femur 55.00 mm,
    tibia (knee->foot tip) 80.06 mm
  APPROXIMATIONS: servo housings are SG90 datasheet boxes (9 g); printed-part
  masses assume PLA at 100 % infill; armature/gains are estimates.
-->
<mujoco model="quadruped_leg">
  <compiler angle="radian" meshdir="meshes"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <mesh name="body_u"  file="body_u.stl"  scale="0.001 0.001 0.001" inertia="legacy"/>
    <mesh name="body_d"  file="body_d.stl"  scale="0.001 0.001 0.001" inertia="legacy"/>
    <mesh name="coxa_l"  file="coxa_l.stl"  scale="0.001 0.001 0.001" inertia="legacy"/>
    <mesh name="femur_1" file="femur_1.stl" scale="0.001 0.001 0.001" inertia="legacy"/>
    <mesh name="tibia_l" file="tibia_l.stl" scale="0.001 0.001 0.001" inertia="legacy"/>
    <mesh name="s_hold"  file="s_hold.stl"  scale="0.001 0.001 0.001" inertia="legacy"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.85 0.85 0.85" rgb2="0.75 0.75 0.75"/>
    <material name="grid" texture="grid" texrepeat="20 20"/>
  </asset>

  <default>
    <default class="visual">
      <!-- printed PLA part: VISUAL ONLY, no mass (meshes are not watertight;
           mass is carried by the "massproxy" boxes instead) -->
      <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
    </default>
    <default class="massproxy">
      <!-- invisible box over the part bounding box; mass = mesh volume x PLA -->
      <geom type="box" contype="0" conaffinity="0" group="5" rgba="0 0 0 0"/>
    </default>
    <default class="servo">
      <!-- SG90 proxy box: visual + mass only (datasheet, approx.) -->
      <geom contype="0" conaffinity="0" group="2" mass="0.009" rgba="0.15 0.3 0.75 1"/>
    </default>
    <default class="collision">
      <geom group="3" rgba="1 0.3 0.3 0.4" density="0"/>
    </default>
    <default class="sg90">
      <joint damping="0.002" armature="0.0002" frictionloss="0.001"/>
      <position kp="2.0" kv="0.04" forcerange="-0.176 0.176"
                ctrlrange="-1.5708 1.5708"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 -0.3 0.6" dir="0 0.4 -1" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.01" material="grid"/>

    <!-- Static frame in YOUR FK coordinates (Y up). Origin = coxa axis at the
         height of the femur servo axis (FK body point). -->
    <body name="leg_frame" pos="0 0 0.14" quat="0.707107 0.707107 0 0">
      <site name="body_origin" size="0.002" rgba="1 0 0 1"/>
      <!-- Fixed body: printed plates + body-mounted coxa servo housing -->
      <geom class="visual" mesh="body_d" pos="0.09243 -0.07952 0.021" quat="0.5 -0.5 0.5 0.5" rgba="0.95 0.6 0.2 1" />
      <geom class="visual" mesh="body_u" pos="0.09243 -0.07952 0.021" quat="0.5 -0.5 0.5 0.5" rgba="0.95 0.7 0.3 1" />
      <geom name="coxa_servo_housing" class="servo" type="box" pos="0 -0.0068 -0.00525" size="0.0059 0.01135 0.01125"/>
      <!-- coxa servo axis (global Y), purple like the Matplotlib visualizer -->
      <site name="coxa_servo_axis" type="cylinder" fromto="0 -0.02 0 0 0.02 0"
            size="0.0008" rgba="0.6 0.1 0.8 1"/>

      <body name="coxa">
        <joint name="coxa" class="sg90" axis="0 1 0" range="-1.5708 1.5708"/>
        <geom class="visual" mesh="coxa_l" pos="0.0244 -0.01965 0.16186" quat="0.5 -0.5 0.5 0.5" rgba="0.9 0.9 0.9 1" />
        <geom name="coxa_l_massproxy" class="massproxy" pos="0.0157481 -0.0053 0.00213082" size="0.02175 0.01755 0.00813288" mass="0.00543"/>
        <geom class="visual" mesh="s_hold" pos="0.20512 -0.01962 0.16186" quat="0.5 -0.5 0.5 0.5" rgba="0.3 0.3 0.3 1" />
        <geom name="s_hold_coxa_massproxy" class="massproxy" pos="0.0254959 6.34079e-07 0.0132637" size="0.00799315 0.006 0.003" mass="0.00049"/>
        <!-- femur servo housing is FIXED to the coxa bracket -->
        <geom name="femur_servo_housing" class="servo" type="box" pos="0.02749 -0.00525 -0.00145" size="0.0059 0.01125 0.01135"/>

        <body name="femur" pos="0.02749 0 0">
          <joint name="femur" class="sg90" axis="0 0 1" range="-1.5708 1.5708"/>
          <site name="femur_servo_center" size="0.002" rgba="0 0 1 1"/>
          <geom class="visual" mesh="femur_1" pos="-0.17801 0.01963 0.2029" quat="-0.5 -0.5 -0.5 0.5" rgba="0.2 0.7 0.3 1" />
          <geom name="femur_1_massproxy" class="massproxy" pos="0.0274958 -4.22592e-07 -0.00269083" size="0.0335 0.006 0.0187501" mass="0.00871"/>
          <geom name="femur_col" class="collision" type="capsule"
                fromto="0.008 0 0 0.047 0 0" size="0.004"/>

          <body name="tibia" pos="0.055 0 0">
            <joint name="tibia" class="sg90" axis="0 0 1" range="-1.5708 1.5708"/>
            <site name="knee" size="0.002" rgba="0 0.6 0 1"/>
            <geom class="visual" mesh="tibia_l" pos="0.01962 -0.05803 0.16186" quat="0 -0.707107 0 0.707107" rgba="0.9 0.9 0.9 1" />
            <geom name="tibia_l_massproxy" class="massproxy" pos="0.030144 -1.13991e-06 0.00213221" size="0.0498456 0.0100018 0.00813149" mass="0.00509"/>
            <geom class="visual" mesh="s_hold" pos="-0.01962 -0.17763 0.16186" quat="0.707107 0 0.707107 0" rgba="0.3 0.3 0.3 1" />
            <geom name="s_hold_tibia_massproxy" class="massproxy" pos="6.34079e-07 0.0019941 0.0132637" size="0.006 0.00799315 0.003" mass="0.00049"/>
            <!-- knee servo housing sits in the tibia window: FIXED to the tibia -->
            <geom name="knee_servo_housing" class="servo" type="box" pos="0.00525 0 -0.00145" size="0.01125 0.0059 0.01135"/>
            <geom name="tibia_col" class="collision" type="capsule"
                  fromto="0.02 0 -0.00366 0.07598 0 -0.00366" size="0.003"/>
            <geom name="foot_col" class="collision" type="sphere"
                  pos="0.07998 1e-05 -0.00366" size="0.0025" friction="1 0.01 0.001"/>
            <site name="foot" pos="0.07998 1e-05 -0.00366" size="0.002" rgba="1 0.5 0 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="coxa_servo"  class="sg90" joint="coxa"/>
    <position name="femur_servo" class="sg90" joint="femur"/>
    <position name="tibia_servo" class="sg90" joint="tibia"/>
  </actuator>

  <keyframe>
    <key name="zero" qpos="0 0 0" ctrl="0 0 0"/>
    <key name="fk_initial_45_45_30" qpos="0.785398 0.785398 0.523599"
         ctrl="0.785398 0.785398 0.523599"/>
  </keyframe>
</mujoco>
